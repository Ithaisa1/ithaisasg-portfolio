---
// Tarjeta de un proyecto en la portada. Toda la tarjeta lleva a su ficha.
import { Image } from 'astro:assets';
import type { Proyecto } from '../data/proyectos';
import { fichaUrl, t as textos, type Lang } from '../i18n';

interface Props {
  proyecto: Proyecto;
  lang: Lang;
}

const { proyecto, lang } = Astro.props;
const t = textos(lang);
const p = proyecto.data;
const ficha = fichaUrl(lang, proyecto.id);
---

<article class="card" style={`--proj: ${p.color}`} data-temas={p.categorias.join(' ')}>
  <div class="shot">
    <Image
      src={p.imagen}
      alt=""
      widths={[480, 800]}
      sizes="(min-width: 1000px) 360px, (min-width: 640px) 50vw, 100vw"
    />
  </div>
  <div class="body">
    <p class="meta"><span>{p.tipo}</span><span>{p.fecha}</span></p>
    <h3><a href={ficha}>{p.titulo}</a></h3>
    <p class="resumen">{p.resumen}</p>
    <ul class="tags" aria-label={t.tarjeta.tecnologias}>
      {p.tecnologias.slice(0, 4).map((t) => <li>{t}</li>)}
    </ul>
    <p class="more" aria-hidden="true">{t.tarjeta.verFicha}</p>
  </div>
</article>

<style>
  .card[hidden] {
    display: none;
  }
  .card {
    position: relative;
    display: flex;
    flex-direction: column;
    background: var(--surface);
    border: 1px solid var(--line);
    border-radius: var(--radius);
    overflow: hidden;
    transition:
      transform 0.15s,
      border-color 0.15s;
  }
  .card:hover {
    transform: translateY(-3px);
    border-color: var(--accent);
  }
  /* Al llegar con el teclado, toda la tarjeta se marca con un contorno bien visible */
  .card:focus-within {
    border-color: var(--accent);
    outline: 3px solid var(--accent);
    outline-offset: 3px;
  }
  /* La captura «flota» sobre el color propio de cada proyecto */
  .shot {
    position: relative;
    aspect-ratio: 16 / 10;
    overflow: hidden;
    padding: 18px 18px 0;
    background:
      radial-gradient(circle at 85% 0%, rgb(255 255 255 / 0.14), transparent 55%),
      var(--proj);
  }
  .shot img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: top;
    border-radius: 8px 8px 0 0;
    box-shadow: 0 -6px 30px -8px rgb(0 0 0 / 0.5);
    transition: transform 0.3s;
  }
  .card:hover .shot img {
    transform: translateY(-6px);
  }
  .body {
    display: flex;
    flex-direction: column;
    gap: 10px;
    padding: 18px;
    flex: 1;
  }
  .meta {
    margin: 0;
    display: flex;
    flex-wrap: wrap;
    gap: 4px 14px;
    font-family: var(--f-mono);
    font-size: 0.76rem;
    color: var(--muted);
  }
  .meta span:first-child {
    color: var(--accent);
  }
  h3 {
    margin: 0;
    font-size: 1.2rem;
  }
  /* El enlace del título cubre toda la tarjeta, pero solo se anuncia una vez a los lectores de pantalla */
  h3 a {
    text-decoration: none;
  }
  h3 a::after {
    content: '';
    position: absolute;
    inset: 0;
  }
  h3 a:focus-visible {
    outline: none;
  }
  .resumen {
    margin: 0;
    font-size: 0.94rem;
  }
  .tags {
    margin-top: auto;
  }
  .more {
    margin: 0;
    color: var(--accent);
    font-weight: 600;
    font-size: 0.92rem;
  }
</style>
