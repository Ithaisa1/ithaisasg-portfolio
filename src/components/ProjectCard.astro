---
// Tarjeta de un proyecto en la portada. Toda la tarjeta lleva a su ficha.
import { Image } from 'astro:assets';
import type { Proyecto } from '../data/proyectos';
import { fichaUrl, t as textos, type Lang } from '../i18n';

interface Props {
  proyecto: Proyecto;
  lang: Lang;
}

const { proyecto, lang } = Astro.props;
const t = textos(lang);
const p = proyecto.data;
const ficha = fichaUrl(lang, proyecto.id);
---

<article class:list={['card', { destacado: p.destacado }]} style={`--proj: ${p.color}`}>
  <div class="shot">
    <Image
      src={p.imagen}
      alt=""
      widths={[480, 800, 1200]}
      sizes={p.destacado ? '(min-width: 900px) 560px, 100vw' : '(min-width: 900px) 520px, 100vw'}
    />
  </div>
  <div class="body">
    <p class="meta"><span>{p.tipo}</span><span>{p.fecha}</span></p>
    <h3><a href={ficha}>{p.titulo}</a></h3>
    <p class="resumen">{p.resumen}</p>
    <ul class="tags" aria-label={t.tarjeta.tecnologias}>
      {p.tecnologias.slice(0, 6).map((t) => <li>{t}</li>)}
    </ul>
    <p class="more" aria-hidden="true">{t.tarjeta.verFicha}</p>
  </div>
</article>

<style>
  .card {
    position: relative;
    display: flex;
    flex-direction: column;
    background: var(--surface);
    border: 1px solid var(--line);
    border-radius: var(--radius);
    overflow: hidden;
    transition:
      transform 0.15s,
      border-color 0.15s;
  }
  .card:hover {
    transform: translateY(-3px);
    border-color: var(--accent);
  }
  /* Al llegar con el teclado, toda la tarjeta se marca con un contorno bien visible */
  .card:focus-within {
    border-color: var(--accent);
    outline: 3px solid var(--accent);
    outline-offset: 3px;
  }
  /* La captura «flota» sobre el color propio de cada proyecto */
  .shot {
    position: relative;
    aspect-ratio: 16 / 10;
    overflow: hidden;
    padding: 28px 28px 0;
    background:
      radial-gradient(circle at 85% 0%, rgb(255 255 255 / 0.14), transparent 55%),
      var(--proj);
  }
  .shot img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: top;
    border-radius: 10px 10px 0 0;
    box-shadow: 0 -6px 30px -8px rgb(0 0 0 / 0.5);
    transition: transform 0.3s;
  }
  .card:hover .shot img {
    transform: translateY(-6px);
  }
  .body {
    display: flex;
    flex-direction: column;
    gap: 12px;
    padding: 22px;
    flex: 1;
  }
  .meta {
    margin: 0;
    display: flex;
    flex-wrap: wrap;
    gap: 4px 14px;
    font-family: var(--f-mono);
    font-size: 0.76rem;
    color: var(--muted);
  }
  .meta span:first-child {
    color: var(--accent);
  }
  h3 {
    margin: 0;
    font-size: 1.45rem;
  }
  /* El enlace del título cubre toda la tarjeta, pero solo se anuncia una vez a los lectores de pantalla */
  h3 a {
    text-decoration: none;
  }
  h3 a::after {
    content: '';
    position: absolute;
    inset: 0;
  }
  h3 a:focus-visible {
    outline: none;
  }
  .resumen {
    margin: 0;
  }
  .tags {
    margin-top: auto;
  }
  .more {
    margin: 0;
    color: var(--accent);
    font-weight: 600;
    font-size: 0.92rem;
  }

  /* El proyecto destacado ocupa todo el ancho, con la imagen al lado */
  @media (min-width: 900px) {
    .destacado {
      grid-column: 1 / -1;
      display: grid;
      grid-template-columns: 1.15fr 1fr;
    }
    .destacado .shot {
      aspect-ratio: auto;
      min-height: 360px;
      padding: 40px 0 0 40px;
    }
    .destacado .shot img {
      position: absolute;
      top: 40px;
      left: 40px;
      width: calc(100% - 40px);
      height: calc(100% - 40px);
      object-position: top left;
      border-radius: 10px 0 0 0;
    }
    .destacado .body {
      padding: 32px;
      justify-content: center;
    }
    .destacado h3 {
      font-size: 1.9rem;
    }
  }
</style>
