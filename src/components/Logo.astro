---
// Logo «isg»: tus iniciales en un solo trazo; el punto de la «i» es el sol.
// El trazo usa el color del texto (currentColor), así sirve sobre fondo claro y oscuro.
interface Props {
  height?: number; // Alto en píxeles; el ancho se calcula solo
  title?: string; // Si se indica, los lectores de pantalla leen este texto
}
const { height = 32, title } = Astro.props;
const width = Math.round((height * 73) / 68);
---

<svg
  viewBox="4 3 73 68"
  width={width}
  height={height}
  role={title ? 'img' : undefined}
  aria-label={title}
  aria-hidden={title ? undefined : 'true'}
>
  <circle cx="14" cy="13" r="7" fill="var(--warm, #e2643b)"></circle>
  <path
    d="M14 26 L14 44 Q14 52 22 52 L32 52 C40 52 41 40 32 40 C23 40 24 28 32 28 L70 28 M70 28 L70 56 Q70 64 62 64 L52 64"
    fill="none"
    stroke="currentColor"
    stroke-width="6.5"
    stroke-linecap="round"
    stroke-linejoin="round"></path>
  <circle cx="58" cy="40" r="12" fill="none" stroke="currentColor" stroke-width="6.5"></circle>
</svg>
