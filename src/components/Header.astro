---
// Cabecera fija con el nombre y la navegación, sobre la banda oscura de la marca.
// Los enlaces empiezan por «/» para que funcionen también desde las fichas de proyecto.
import Logo from './Logo.astro';

const enlaces = [
  { href: '/#proyectos', texto: 'Proyectos' },
  { href: '/#experiencia', texto: 'Experiencia' },
  { href: '/#habilidades', texto: 'Habilidades', opcional: true },
  { href: '/#contacto', texto: 'Contacto' },
];
---

<header class="top">
  <div class="wrap bar">
    <a class="mark" href="/" aria-label="Ithaisa Sánchez, ir al inicio">
      <Logo height={30} />
      <span class="name" aria-hidden="true">Ithaisa Sánchez</span>
    </a>
    <nav aria-label="Principal">
      <ul>
        {
          enlaces.map((e) => (
            <li class:list={{ opcional: e.opcional }}>
              <a href={e.href}>{e.texto}</a>
            </li>
          ))
        }
      </ul>
    </nav>
  </div>
</header>

<style>
  .top {
    position: sticky;
    top: 0;
    z-index: 10;
    background: var(--band);
    color: var(--band-ink);
    border-bottom: 1px solid var(--band-line);
  }
  .bar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
    min-height: 60px;
  }
  .mark {
    display: flex;
    align-items: center;
    gap: 12px;
    font-family: var(--f-display);
    font-weight: 700;
    font-size: 1.05rem;
    text-decoration: none;
    letter-spacing: -0.01em;
  }
  /* Línea fina entre el logo y el nombre */
  .name {
    padding-left: 12px;
    border-left: 1px solid var(--band-line);
    white-space: nowrap;
  }
  @media (max-width: 480px) {
    .name {
      display: none;
    }
  }
  ul {
    display: flex;
    gap: 4px;
    list-style: none;
    margin: 0;
    padding: 0;
  }
  nav a {
    display: inline-block;
    padding: 10px 10px;
    text-decoration: none;
    font-size: 0.92rem;
    color: var(--band-muted);
    border-radius: 8px;
  }
  nav a:hover {
    color: var(--band-ink);
    background: var(--band-line);
  }
  .top :focus-visible {
    outline-color: var(--band-accent);
  }
  @media (max-width: 560px) {
    .opcional {
      display: none;
    }
    nav a {
      padding: 10px 6px;
    }
  }
</style>
