---
// Cabecera fija con el nombre, la navegación y el cambio de idioma, sobre la banda oscura de la marca.
// Los enlaces llevan la ruta de la portada para que funcionen también desde las fichas de proyecto.
import Logo from './Logo.astro';
import { inicio, t as textos, type Lang } from '../i18n';

interface Props {
  lang: Lang;
  otroIdioma: string; // Esta misma página en el otro idioma
}
const { lang, otroIdioma } = Astro.props;
const t = textos(lang);
const base = inicio(lang);

const enlaces = [
  { href: `${base}#proyectos`, texto: t.nav.proyectos },
  { href: `${base}#experiencia`, texto: t.nav.experiencia, estrecho: true },
  { href: `${base}#habilidades`, texto: t.nav.habilidades, opcional: true },
  { href: `${base}#contacto`, texto: t.nav.contacto },
];
---

<header class="top">
  <div class="wrap bar">
    <a class="mark" href={base} aria-label={t.irInicio}>
      <Logo height={30} />
      <span class="name" aria-hidden="true">Ithaisa Sánchez</span>
    </a>
    <nav aria-label={t.navPrincipal}>
      <ul>
        {
          enlaces.map((e) => (
            <li class:list={{ opcional: e.opcional, estrecho: e.estrecho }}>
              <a href={e.href}>{e.texto}</a>
            </li>
          ))
        }
        <li>
          <a class="idioma" href={otroIdioma} hreflang={t.otroIdioma.lang} lang={t.otroIdioma.lang}>
            <span aria-hidden="true">{t.otroIdioma.corto}</span>
            <span class="visually-hidden">{t.otroIdioma.largo}</span>
          </a>
        </li>
      </ul>
    </nav>
  </div>
</header>

<style>
  .top {
    position: sticky;
    top: 0;
    z-index: 10;
    background: var(--band);
    color: var(--band-ink);
    border-bottom: 1px solid var(--band-line);
  }
  .bar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
    min-height: 60px;
  }
  .mark {
    display: flex;
    align-items: center;
    gap: 12px;
    font-family: var(--f-display);
    font-weight: 700;
    font-size: 1.05rem;
    text-decoration: none;
    letter-spacing: -0.01em;
  }
  /* Línea fina entre el logo y el nombre */
  .name {
    padding-left: 12px;
    border-left: 1px solid var(--band-line);
    white-space: nowrap;
  }
  @media (max-width: 480px) {
    .name {
      display: none;
    }
  }
  ul {
    display: flex;
    gap: 4px;
    list-style: none;
    margin: 0;
    padding: 0;
  }
  nav a {
    display: inline-block;
    padding: 10px 10px;
    text-decoration: none;
    font-size: 0.92rem;
    color: var(--band-muted);
    border-radius: 8px;
  }
  nav a:hover {
    color: var(--band-ink);
    background: var(--band-line);
  }
  /* Cambio de idioma: una pastilla pequeña al final del menú */
  nav a.idioma {
    margin-left: 4px;
    font-family: var(--f-mono);
    font-weight: 700;
    color: var(--band-ink);
    border: 1px solid var(--band-line);
  }
  .top :focus-visible {
    outline-color: var(--band-accent);
  }
  @media (max-width: 560px) {
    .opcional {
      display: none;
    }
    nav a {
      padding: 10px 6px;
    }
  }
  /* Móviles estrechos: menú más compacto para que quepa también el cambio de idioma */
  @media (max-width: 400px) {
    ul {
      gap: 0;
    }
    nav a {
      padding: 10px 5px;
      font-size: 0.86rem;
    }
    nav a.idioma {
      margin-left: 2px;
      padding: 9px 6px;
    }
  }
  /* Pantallas muy pequeñas (320 px): se quita también «Experiencia» del menú */
  @media (max-width: 345px) {
    .estrecho {
      display: none;
    }
  }
</style>
