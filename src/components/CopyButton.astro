---
// Botón «Copiar». Si el navegador no permite copiar, selecciona el texto para copiarlo a mano.
import { t as textos, type Lang } from '../i18n';

interface Props {
  value: string;
  label: string; // Texto para lectores de pantalla, por ejemplo «Copiar email»
  lang: Lang;
}
const { value, label, lang } = Astro.props;
const t = textos(lang).contacto;
---

<button
  type="button"
  class="copy"
  data-copy={value}
  data-copiar={t.copiar}
  data-copiado={t.copiado}
  data-aviso={t.copiadoAviso}
  data-manual={t.copiaManual}
  aria-label={label}>{t.copiar}</button
>
<span class="visually-hidden" role="status" aria-live="polite"></span>

<style>
  .copy {
    background: var(--bg);
    color: var(--ink);
    border: 0;
    border-radius: 999px;
    padding: 9px 16px;
    font: 600 0.82rem var(--f-body);
    cursor: pointer;
    white-space: nowrap;
  }
</style>

<script>
  document.querySelectorAll<HTMLButtonElement>('button[data-copy]').forEach((btn) => {
    btn.addEventListener('click', async () => {
      const value = btn.dataset.copy ?? '';
      const status = btn.nextElementSibling as HTMLElement | null;
      try {
        await navigator.clipboard.writeText(value);
        btn.textContent = btn.dataset.copiado ?? '';
        if (status) status.textContent = btn.dataset.aviso ?? '';
        setTimeout(() => {
          btn.textContent = btn.dataset.copiar ?? '';
          if (status) status.textContent = '';
        }, 1800);
      } catch {
        // Sin permiso para el portapapeles: seleccionamos el texto
        const text = btn.parentElement?.querySelector('span > a');
        if (text) {
          const range = document.createRange();
          range.selectNodeContents(text);
          const sel = window.getSelection();
          sel?.removeAllRanges();
          sel?.addRange(range);
        }
        btn.textContent = btn.dataset.manual ?? '';
      }
    });
  });
</script>
