---
import { perfil } from '../data/perfil';
const year = new Date().getFullYear();
---

<footer class="wrap">
  <span>© {year} {perfil.nombre}</span>
</footer>

<style>
  footer {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: 8px;
    padding-block: 32px;
    margin-top: 24px;
    border-top: 1px solid var(--line);
    color: var(--muted);
    font-size: 0.88rem;
  }
  a {
    text-underline-offset: 3px;
  }
</style>
