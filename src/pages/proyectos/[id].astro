---
// Ficha de cada proyecto en español. El contenido está en src/components/PaginaProyecto.astro.
import PaginaProyecto from '../../components/PaginaProyecto.astro';
import { getProyectos } from '../../data/proyectos';

export async function getStaticPaths() {
  const proyectos = await getProyectos('es');
  return proyectos.map((proyecto, i) => ({
    params: { id: proyecto.id },
    props: { proyecto, siguiente: proyectos[(i + 1) % proyectos.length] },
  }));
}

const { proyecto, siguiente } = Astro.props;
---

<PaginaProyecto lang="es" proyecto={proyecto} siguiente={siguiente} />
