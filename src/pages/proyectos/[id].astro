---
// Ficha de un proyecto. Se genera una página por cada archivo de src/content/proyectos/.
import { Image } from 'astro:assets';
import { getCollection, render, type CollectionEntry } from 'astro:content';
import Base from '../../layouts/Base.astro';

export async function getStaticPaths() {
  const proyectos = (await getCollection('proyectos')).sort((a, b) => a.data.orden - b.data.orden);
  return proyectos.map((proyecto, i) => ({
    params: { id: proyecto.id },
    props: { proyecto, siguiente: proyectos[(i + 1) % proyectos.length] },
  }));
}

interface Props {
  proyecto: CollectionEntry<'proyectos'>;
  siguiente: CollectionEntry<'proyectos'>;
}

const { proyecto, siguiente } = Astro.props;
const p = proyecto.data;
const { Content } = await render(proyecto);
---

<Base title={p.titulo} description={p.resumen}>
  <article class="wrap">
    <p class="back"><a href="/#proyectos">← Todos los proyectos</a></p>

    <header class="intro">
      <p class="meta"><span>{p.tipo}</span><span>{p.fecha}</span></p>
      <h1>{p.titulo}</h1>
      <p class="lede">{p.resumen}</p>
      <div class="actions">
        {
          p.demo && (
            <a class="btn primary" href={p.demo} rel="noopener">
              Ver la web
              {p.demoNota && <span class="small">({p.demoNota.toLowerCase()})</span>}
            </a>
          )
        }
        {
          p.codigo && (
            <a class="btn" href={p.codigo} rel="noopener">
              Ver el código
            </a>
          )
        }
        {p.codigoNota && <p class="note">{p.codigoNota}</p>}
      </div>
    </header>

    <figure class="shot">
      <Image src={p.imagen} alt={p.imagenAlt} widths={[600, 1000, 1600]} sizes="(min-width: 1120px) 1072px, 100vw" loading="eager" />
    </figure>

    <div class="layout">
      <aside aria-label="Ficha rápida">
        <dl>
          <div><dt>Estado</dt><dd>{p.estado}</dd></div>
          <div><dt>Fecha</dt><dd>{p.fecha}</dd></div>
          <div>
            <dt>Tecnologías</dt>
            <dd>
              <ul class="tags">{p.tecnologias.map((t) => <li>{t}</li>)}</ul>
            </dd>
          </div>
        </dl>
      </aside>
      <div class="prose">
        <Content />
      </div>
    </div>

    <nav class="next" aria-label="Siguiente proyecto">
      <span class="label">Siguiente proyecto</span>
      <a href={`/proyectos/${siguiente.id}/`}>{siguiente.data.titulo} →</a>
    </nav>
  </article>
</Base>

<style>
  .back {
    margin: 28px 0 0;
  }
  .back a {
    color: var(--muted);
    text-decoration: none;
    font-size: 0.92rem;
  }
  .back a:hover {
    color: var(--ink);
  }
  .intro {
    padding-block: 28px 32px;
    max-width: 760px;
  }
  .meta {
    margin: 0;
    display: flex;
    flex-wrap: wrap;
    gap: 4px 14px;
    font-family: var(--f-mono);
    font-size: 0.8rem;
    color: var(--muted);
  }
  .meta span:first-child {
    color: var(--accent);
  }
  h1 {
    font-size: clamp(2.2rem, 5.5vw, 3.6rem);
    font-weight: 800;
    letter-spacing: -0.035em;
    margin: 12px 0 14px;
  }
  .lede {
    font-size: 1.15rem;
    margin: 0 0 24px;
  }
  .actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 12px;
  }
  .small {
    font-weight: 400;
    opacity: 0.8;
    font-size: 0.85rem;
  }
  .note {
    margin: 0;
    font-family: var(--f-mono);
    font-size: 0.82rem;
    color: var(--muted);
  }
  .shot {
    margin: 0 0 48px;
    border: 1px solid var(--line);
    border-radius: var(--radius);
    overflow: hidden;
    background: var(--surface);
  }
  .layout {
    display: grid;
    gap: 32px;
  }
  .layout > * {
    min-width: 0;
  }
  @media (min-width: 900px) {
    .layout {
      grid-template-columns: 240px 1fr;
      gap: 56px;
    }
    aside {
      position: sticky;
      top: 84px;
      align-self: start;
    }
  }
  dl {
    margin: 0;
    display: grid;
    gap: 18px;
  }
  dt {
    font-family: var(--f-mono);
    font-size: 0.74rem;
    text-transform: uppercase;
    letter-spacing: 0.12em;
    color: var(--muted);
    margin-bottom: 4px;
  }
  dd {
    margin: 0;
  }
  .next {
    display: flex;
    flex-direction: column;
    gap: 4px;
    margin-top: 56px;
    padding-top: 28px;
    border-top: 1px solid var(--line);
  }
  .next a {
    font-family: var(--f-display);
    font-weight: 700;
    font-size: 1.5rem;
    color: var(--accent);
    text-decoration: none;
  }
  .next a:hover {
    text-decoration: underline;
  }
</style>
