---
import Base from '../layouts/Base.astro';
---

<Base title="Página no encontrada" description="Esta página no existe.">
  <div class="wrap box">
    <p class="label">Error 404</p>
    <h1>Esta página no existe</h1>
    <p>Puede que el enlace esté mal escrito o que la página se haya movido.</p>
    <div class="ctas">
      <a class="btn primary" href="/">Ir al inicio</a>
      <a class="btn" href="/#proyectos">Ver proyectos</a>
    </div>
  </div>
</Base>

<style>
  .box {
    padding-block: 96px;
    max-width: 640px;
  }
  h1 {
    font-size: clamp(2rem, 5vw, 3rem);
    margin: 10px 0 12px;
  }
  .ctas {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
    margin-top: 24px;
  }
</style>
